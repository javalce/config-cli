{
  "name": "@javalce/config",
  "version": "0.2.1",
  "description": "A CLI to bootstrap ESLint and Prettier using my configurations",
  "keywords": [
    "eslint",
    "prettier",
    "cli",
    "config"
  ],
  "homepage": "https://github.com/javalce/config-cli#readme",
  "bugs": {
    "url": "https://github.com/javalce/config-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/javalce/config-cli.git"
  },
  "license": "MIT",
  "author": "Javier Valero <javalce29@gmail.com>",
  "type": "module",
  "bin": {
    "javalce-config": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsx src/index.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepack": "pnpm build",
    "prepare": "husky",
    "release": "release-it",
    "typecheck": "tsc"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "dependencies": {
    "@clack/prompts": "1.7.0",
    "ansis": "4.3.1",
    "commander": "15.0.0",
    "local-pkg": "1.2.1",
    "package-manager-detector": "1.8.0",
    "prettier": "3.9.6",
    "tinyexec": "1.3.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@commitlint/types": "21.2.0",
    "@javalce/eslint-config": "0.26.0",
    "@javalce/prettier-config": "2.2.3",
    "@release-it/conventional-changelog": "12.0.0",
    "@types/fs-extra": "11.0.4",
    "@types/node": "24.13.3",
    "eslint": "9.39.5",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "release-it": "21.0.1",
    "tsdown": "0.22.14",
    "tsx": "4.23.5",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
